<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd LaunchAgent for the Venture Factory daily loop.
  This is a TEMPLATE: scripts/install_schedule.sh substitutes the __PLACEHOLDERS__
  (absolute uv path, repo working dir, local clock time for 06:00 Asia/Jerusalem,
  log paths) and copies the result to ~/Library/LaunchAgents/.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.youval.venturefactory.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>daily-loop</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- 06:00 Asia/Jerusalem, expressed in the machine's local clock at install time. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>__HOUR__</integer>
        <key>Minute</key>
        <integer>__MINUTE__</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__OUT__</string>
    <key>StandardErrorPath</key>
    <string>__ERR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>
</dict>
</plist>
